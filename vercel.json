{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/services",
      "destination": "/capabilities",
      "permanent": true
    },
    {
      "source": "/inclever",
      "destination": "/products/inclever",
      "permanent": true
    },
    {
      "source": "/learn/what-is-context-engineering",
      "destination": "/context-engineering",
      "permanent": true
    }
  ]
}
